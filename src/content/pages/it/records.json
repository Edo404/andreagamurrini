   "paragraphs": [
    {
     "tag": "p",
     "html": "<span style=\"letter-spacing:normal\"><span style=\"font-family:var(--font-futura)\"><span style=\"font-style:italic\"><span style=\"color:rgb(255,231,127)\">A livello compositivo, dr.gam ha innato il senso dello spiazzamento, o meglio la capacità di sorprendere l'ascoltatore portandolo ad essere piacevolmente soggiogato e profondamente coinvolto; una qualità questa, che manca nella stragrande maggioranza della musica contemporanea che è invece, prevedibile, compiacente e che di conseguenza viene dimenticata in poco tempo</span></span></span></span>",
     "style": {
      "fontFamily": "var(--font-din)",
      "fontSize": "15px",
      "fontWeight": "400",
      "fontStyle": "normal",
      "color": "rgb(0, 61, 77)",
      "textAlign": "justify",
      "lineHeight": "normal"
     }
    },
    {
     "tag": "p",
     "html": "<span style=\"letter-spacing:normal\"><span style=\"font-family:var(--font-futura)\"><span style=\"color:rgb(255,255,255)\"><span style=\"font-style:italic\">M° Peppe Vessicchio </span></span></span></span>",
     "style": {
